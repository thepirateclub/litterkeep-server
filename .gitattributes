# Нормализация переводов строк.
#
# Без этого правила содержимое индекса зависит от локальной настройки
# core.autocrlf каждого участника: файл, закоммиченный с Windows, получает
# CRLF, а с Linux - LF, и репозиторий расходится целыми файлами.
# Правило фиксирует LF в индексе и в рабочем дереве на всех платформах.
* text=auto eol=lf

# Сгенерированные таблицы charset - бинарные, нормализация их сломает.
*.bin binary

# Windows-only пакетные файлы требуют CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
